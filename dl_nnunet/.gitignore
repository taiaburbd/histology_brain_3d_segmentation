# Ignore files generated by Python
*.pyc
__pycache__/

# Ignore files generated by editors
*~
.*.swp
.DS_Store

# Ignore virtual environment folders
venv/
env/
.venv/    
# Add this line to ignore .venv folder

# Ignore data and files that are specific to your local environment
/data/
/result/
/dataset/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore compiled files
*.exe
*.dll
*.so
*.dylib

# Ignore logs and temporary files
*.log
*.tmp

# Ignore package files
*.egg-info/
dist/
build/

# Ignore system files and directories
/.idea/
/.vscode/
